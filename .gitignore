# Wine prefixes: large, machine-local
bottles/
*.bottle

# Downloaded / built engine binaries (fetched from upstream or hosted as GitHub
# release assets; see scripts/ensure-*.sh and scripts/upload-assets.sh)
engine/
*.tar.gz
*.tar.xz
*.tar.zst
*.dmg

# Build output and packaged app / build kit.
build/
dist/

# Third-party source + build trees (Wine, DXMT). Our own patches live in
# wine-fixes/patches/ and ARE committed; the upstream source is fetched/rebuilt.
thirdparty/

# macOS
.DS_Store

# Xcode / SwiftPM
app/.build/
app/.swiftpm/
*.xcuserstate
DerivedData/

# Logs and crash dumps
*.log
*.dmp

# Generated by scripts/make-build-kit.sh
BUILD-KIT-README.md

# Project-instruction / assistant files (not part of the public source)
CLAUDE.md
CLAUDE.local.md
**/CLAUDE.md
.claude/
